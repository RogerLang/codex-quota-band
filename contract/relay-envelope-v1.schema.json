{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.codex-quota.invalid/contract/relay-envelope-v1.schema.json",
  "title": "CodexQuota relay envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nonce", "ciphertext"],
  "properties": {
    "version": { "const": 1 },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
    "ciphertext": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 98304 }
  }
}
