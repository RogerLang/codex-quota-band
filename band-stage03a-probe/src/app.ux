<script>
import app from '@system.app'
import interconnect from '@system.interconnect'
import file from '@system.file'
import stage03 from './common/stage03-state.cjs'

const connection = interconnect.instance()
const SEQUENCE_URI = 'internal://files/watchface_sequence.txt'
const STATE_URI = 'internal://files/watchface_state.json'
const AUTO_RETURN_DELAY_MS = 120

function rawMessage(event) {
  return event && event.data !== undefined ? event.data : event
}

function returnToWatchfaceSoon() {
  setTimeout(() => {
    try { app.terminate() } catch (_) {}
  }, AUTO_RETURN_DELAY_MS)
}

function sendAck(message, persisted) {
  try {
    connection.send({
      data: stage03.createAck(message, persisted),
      success: returnToWatchfaceSoon,
      fail: () => {},
    })
  } catch (_) {}
}

function persist(message) {
  const updatedAt = Date.now()
  file.writeText({
    uri: STATE_URI,
    text: stage03.persistedState(message, updatedAt),
    append: false,
    success: () => {
      file.writeText({
        uri: SEQUENCE_URI,
        text: String(message.sequence),
        append: false,
        success: () => sendAck(message, true),
        fail: () => sendAck(message, false),
      })
    },
    fail: () => sendAck(message, false),
  })
}

function installStage03Handler() {
  connection.onmessage = (event) => {
    const message = stage03.parseState(rawMessage(event))
    if (message) persist(message)
  }
}

installStage03Handler()

export default {
  onCreate() { installStage03Handler() },
  onDestroy() {}
}
</script>
